{
  "name": "campusnest",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "worker:missions": "tsx packages/ai/src/missions/worker-loop.ts",
    "clean": "turbo clean",
    "review": "codex review --base main",
    "review:staged": "codex review --uncommitted",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "axios": "1.15.2",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.0",
      "happy-dom": "20.8.9",
      "hono": "4.12.18",
      "@hono/node-server": "1.19.13",
      "basic-ftp": "5.3.1",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": "5.0.5",
      "esbuild": "0.25.0",
      "fast-uri": "3.1.2",
      "file-type": "21.3.2",
      "lodash": "4.18.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.10",
      "protobufjs": "7.5.6",
      "protocol-buffers-schema": "3.6.1",
      "ip-address": "10.1.1",
      "undici": "7.24.0",
      "vite": "6.4.2",
      "yaml": "2.8.3"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
