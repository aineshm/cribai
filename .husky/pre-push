#!/usr/bin/env sh

# MANDATORY: Codex review on every push. Cannot be skipped with --no-verify.
# Genuine codex findings HARD-BLOCK the push.
# Exception (AIN-49): if codex is UNAVAILABLE (rate-limit / auth / transport outage),
# the hook warns and allows the push — an external codex outage must not halt all dev.
# A substitute review (human or subagent) is expected in that case.

echo "========================================="
echo "  MANDATORY Codex Review (pre-push)"
echo "  Cannot be skipped. No exceptions."
echo "========================================="

# Get the remote and branch being pushed to
remote="$1"
url="$2"

# Read stdin to get the ref info
while read local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    # Deleting a branch, skip review
    continue
  fi

  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # New branch — review all commits
    base="HEAD~5"
  else
    # Existing branch — review diff against remote
    base="$remote_oid"
  fi

  echo ""
  echo "Reviewing commits: $base...$local_oid"
  echo ""

  # Run codex review on the diff being pushed.
  # NOTE (AIN-52): do NOT pin `-c model=...` here. The AIN-49 attempt pinned
  # `gpt-5.4` for a cheaper gate, but ChatGPT-account codex plans REJECT it with
  # a 400 "model not supported" — which is NOT in the graceful-degradation grep
  # below, so it would HARD-BLOCK every push (it only slipped through on transient
  # TokenRefreshFailed noise). Use the account default (config.toml), which is the
  # `codex review --base <ref>` form proven to work. If a cheaper gate is wanted
  # later, pin only a model the account actually supports.
  # `if` form so `set -e` doesn't abort before we can classify a non-zero exit.
  if codex review --base "$base" > /tmp/codex_prepush.log 2>&1; then
    REVIEW_EXIT=0
  else
    REVIEW_EXIT=$?
  fi
  cat /tmp/codex_prepush.log

  if [ $REVIEW_EXIT -ne 0 ]; then
    # AIN-87: a missing/blocked codex BINARY is an outage, not findings.
    # Covers: npm wrapper spawn ENOENT (binary quarantined/deleted — e.g. the
    # 2026-07-01 macOS malware-flag incident) and the CLI not being installed
    # at all ("codex: command not found" / "codex: not found"). Deliberately
    # narrow patterns so genuine review findings mentioning "not found" in
    # code context can never be misread as an outage.
    if grep -qiE "usage limit|TokenRefreshFailed|worker quit with fatal|rate limit|stream error|connection refused|timed out|ENOENT|codex: command not found|codex: not found|command not found: codex" /tmp/codex_prepush.log; then
      echo ""
      echo "⚠️  Codex UNAVAILABLE (outage: rate-limit/auth/transport) — allowing push (AIN-49)."
      echo "    REQUIRED substitute (the new default while codex is rate-limited"
      echo "    until ~Jul 8 2026): dispatch a Claude review agent on this diff via"
      echo "    Claude Code (code + security review of \`git diff <base>...HEAD\`)."
      echo "    Fix any CRITICAL/HIGH findings before merge. Codex resumes as the"
      echo "    gate automatically once available again."
    else
      echo ""
      echo "❌ Codex review found issues (exit code $REVIEW_EXIT)."
      echo "Fix the issues above before pushing."
      exit 1
    fi
  fi
done

echo ""
echo "✅ Codex review passed"
echo ""
