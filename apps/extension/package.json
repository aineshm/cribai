{
  "name": "@campusnest/extension",
  "version": "0.1.0",
  "private": true,
  "description": "CribAI Chrome Extension MV3 — save listing pages to your apartment CRM",
  "scripts": {
    "dev": "vite build --watch",
    "dev:content": "vite build --watch --config vite.content.config.ts",
    "build": "vite build && vite build --config vite.content.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0"
  },
  "devDependencies": {
    "@campusnest/ai": "workspace:*",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
