# CribAI Extension build-time environment variables
# Copy this to .env and fill in real values.
# These are injected at Vite build time via define — they become literals in
# the compiled bundle, NOT process.env references.

# App domain — used as the fallback for the API base URL.
VITE_CRIBAI_APP_DOMAIN=https://cribai.app

# User-facing web URL for deep-links ("Open My Apartments" after save).
# Must be https:// — the guard in content/popup rejects http:// links.
# Falls back to the prod Vercel deployment if not set. Override here if
# you point the extension at a custom deployment.
VITE_CRIBAI_WEB_APP_URL=https://ai-real-estate-agent.vercel.app

# API base URL — where ingest/saved requests are sent. May differ from
# WEB_APP_URL (e.g. http://localhost:3000 in dev, preview URL in staging).
# Defaults to VITE_CRIBAI_APP_DOMAIN if not set.
# VITE_CRIBAI_API_BASE=http://localhost:3000

# Supabase project URL (from Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon/public key — safe to embed (Row Level Security enforces access)
# Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
