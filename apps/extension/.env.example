# CribAI Extension build-time environment variables
# Copy this to .env and fill in real values.
# These are injected at Vite build time via define — they become literals in
# the compiled bundle, NOT process.env references.

# App domain — used for deep-links ("View My Apartments" after save)
VITE_CRIBAI_APP_DOMAIN=https://cribai.app

# API base URL — may differ from APP_DOMAIN on preview deploys.
# Defaults to VITE_CRIBAI_APP_DOMAIN if not set.
# VITE_CRIBAI_API_BASE=https://preview-abc123.vercel.app

# Supabase project URL (from Supabase dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://yzplusypxgvqkrmejcuf.supabase.co

# Supabase anon/public key — safe to embed (Row Level Security enforces access)
# Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
