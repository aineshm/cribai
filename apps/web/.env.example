
# Personal CRM (My Apartments) — mock-data seam. true (default) = local fixtures; false = /api/crm/* backend
NEXT_PUBLIC_CRM_MOCK=true
# Personal CRM (My Apartments) — visibility gate ("merge dark" kill-switch). Off
# unless 'true': routes 404 and nav entries are hidden. Distinct from the MOCK
# seam above. Set true to develop/test the feature (and for the e2e suite).
NEXT_PUBLIC_CRM_ENABLED=true
