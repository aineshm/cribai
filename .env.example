# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Dev Auth Bypass — set to "true" to skip OTP/Supabase Auth entirely.
# Uses mock users defined in apps/web/lib/dev-auth.ts.
# NEVER set this in production.
# BYPASS_AUTH=true

# Gemini AI (CribAI) — Vertex AI preferred, AI Studio as fallback
# Option A: Vertex AI (recommended — set project + run `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Option B: AI Studio API key (free tier, rate limited)
# GEMINI_API_KEY=

# Google Places (neighborhood reviews)
GOOGLE_PLACES_API_KEY=

# Email delivery (Resend) — required for Tour Outreach Mission (Phase 28)
# Dev: from-address is onboarding@resend.dev (no domain verification needed)
# Prod: verify campusnest.app at resend.com/domains before go-live
RESEND_API_KEY=

# Stripe (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox (map UI)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Apify (web scraping)
APIFY_API_TOKEN=

# Tavily (AI search)
TAVILY_API_KEY=

# Walk Score API
WALKSCORE_API_KEY=

# Admin email whitelist — comma-separated emails that bypass .edu validation
# NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,recruiter@gmail.com

# Feature flags
ENABLE_APARTMENTS_COM=false

# Google Cloud credentials (service account)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
