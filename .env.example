# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Dev Auth Bypass — set to "true" to skip OTP/Supabase Auth entirely.
# Uses mock users defined in apps/web/lib/dev-auth.ts.
# NEVER set this in production.
# BYPASS_AUTH=true

# Gemini AI (CribAI) — Vertex AI preferred, AI Studio as fallback
# Option A: Vertex AI (recommended — set project + run `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Option B: AI Studio API key (free tier, rate limited)
# GEMINI_API_KEY=

# Claude AI (legacy — being migrated to Gemini)
ANTHROPIC_API_KEY=

# Email delivery (Resend) — required for Tour Outreach Mission (Phase 28)
# Dev: from-address is onboarding@resend.dev (no domain verification needed)
# Prod: verify campusnest.app at resend.com/domains before go-live
RESEND_API_KEY=

# Stripe (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
